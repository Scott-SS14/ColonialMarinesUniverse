<DefaultWindow xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="https://spacestation14.io" MinSize="900 680" SetSize="1080 780">
    <PanelContainer Name="Bezel">
        <Control Name="Fascia" />
        <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="22 20 22 18">
            <PanelContainer Name="CabinetPlate">
                <BoxContainer Margin="12 7" SeparationOverride="12">
                    <Label Name="CabinetBrand" HorizontalExpand="True" ClipText="True" />
                    <Label Name="ModelCaption" />
                </BoxContainer>
            </PanelContainer>
            <BoxContainer SeparationOverride="16" VerticalExpand="True">
                <PanelContainer Name="Screen" HorizontalExpand="True">
                    <PanelContainer Name="Tube" Margin="8">
                        <PanelContainer Name="TubeContent">
                            <BoxContainer Orientation="Vertical" VerticalExpand="True" SeparationOverride="9" Margin="10">
                                <PanelContainer Name="HeaderPanel">
                                    <BoxContainer SeparationOverride="12" Margin="12 7">
                                        <TextureRect Name="FactionLogo" MinSize="70 48" MaxSize="70 48" Stretch="KeepAspectCentered" MouseFilter="Ignore" />
                                        <BoxContainer Orientation="Vertical" Margin="0 5" SeparationOverride="3" HorizontalExpand="True">
                                            <Label Name="Brand" />
                                            <Label Name="Heading" />
                                        </BoxContainer>
                                        <Control Name="SignalArt" MinSize="72 24" MaxSize="72 24" VerticalAlignment="Center" MouseFilter="Ignore" />
                                    </BoxContainer>
                                </PanelContainer>
                                <BoxContainer Name="ColonyApplications" Visible="False" SeparationOverride="7">
                                    <Button Name="PersonnelApp" HorizontalExpand="True" />
                                    <Button Name="ManifestApp" HorizontalExpand="True" />
                                    <Button Name="PayrollApp" HorizontalExpand="True" />
                                    <Button Name="CommunicationsApp" HorizontalExpand="True" />
                                </BoxContainer>
                                <BoxContainer Name="OfficeApplications" Visible="False" SeparationOverride="7">
                                    <Button Name="OfficeServicesApp" HorizontalExpand="True" />
                                    <Button Name="OfficeRequestsApp" HorizontalExpand="True" />
                                    <Button Name="OfficeJailApp" HorizontalExpand="True" />
                                </BoxContainer>
                                <BoxContainer SeparationOverride="8">
                                    <Label Name="Status" HorizontalExpand="True" ClipText="True" />
                                    <Button Name="RefreshButton" />
                                </BoxContainer>
                                <PanelContainer Name="WorkflowPanel">
                                    <BoxContainer Margin="8 4" SeparationOverride="12">
                                        <Label Name="ReadStage" HorizontalExpand="True" ClipText="True" />
                                        <Label Name="WriteStage" HorizontalExpand="True" ClipText="True" />
                                        <Label Name="PrintStage" HorizontalExpand="True" ClipText="True" />
                                    </BoxContainer>
                                </PanelContainer>
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="9" MinWidth="0" VerticalExpand="True" Name="EmploymentPage">
                                    <Label Name="CurrentTitle" ClipText="True" />
                                    <BoxContainer Name="Workspace" Orientation="Vertical" VerticalExpand="True" SeparationOverride="10">
                                        <PanelContainer Name="IdentityPanel">
                                            <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="5">
                                                <BoxContainer SeparationOverride="12">
                                                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                                        <Label Name="NameCaption" />
                                                        <LineEdit Name="NameField" />
                                                    </BoxContainer>
                                                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                                        <Label Name="TitleCaption" />
                                                        <LineEdit Name="TitleField" />
                                                    </BoxContainer>
                                                </BoxContainer>
                                                <CheckBox Name="Iff" />
                                                <Label Name="IffHint" />
                                                <BoxContainer Name="IconRow" SeparationOverride="8">
                                                    <Label Name="IconCaption" VerticalAlignment="Center" />
                                                    <TextureRect Name="IconPreview" MinSize="24 24" MaxSize="24 24" />
                                                    <OptionButton Name="IconChoices" HorizontalExpand="True" />
                                                </BoxContainer>
                                            </BoxContainer>
                                        </PanelContainer>
                                        <BoxContainer SeparationOverride="10" VerticalExpand="True">
                                            <PanelContainer Name="PresetPanel" MinWidth="190" MaxWidth="190">
                                                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="7">
                                                    <Label Name="PresetCaption" />
                                                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                                                        <BoxContainer Name="Presets" Orientation="Vertical" SeparationOverride="5" />
                                                    </ScrollContainer>
                                                </BoxContainer>
                                            </PanelContainer>
                                            <PanelContainer Name="AccessPanel" HorizontalExpand="True">
                                                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                                                    <Label Name="AccessCaption" />
                                                    <LineEdit Name="AccessSearch" />
                                                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                                                        <BoxContainer Name="AccessList" Orientation="Vertical" SeparationOverride="4" />
                                                    </ScrollContainer>
                                                    <BoxContainer SeparationOverride="6">
                                                        <Label Name="AccessCount" HorizontalExpand="True" />
                                                        <Button Name="ClearAccessButton" />
                                                    </BoxContainer>
                                                </BoxContainer>
                                            </PanelContainer>
                                        </BoxContainer>
                                    </BoxContainer>
                                    <PanelContainer Name="DossierFrame" Visible="False" VerticalExpand="True">
                                        <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                                            <BoxContainer Margin="10" SeparationOverride="14">
                                                <BoxContainer Orientation="Vertical" MinWidth="250" MaxWidth="250" SeparationOverride="10">
                                                    <PanelContainer Name="CredentialPanel" MinHeight="244">
                                                        <Control Name="CredentialArt" MouseFilter="Ignore" />
                                                        <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="15">
                                                            <TextureRect Name="CredentialLogo" MinSize="90 42" MaxSize="90 42" Stretch="KeepAspectCentered" MouseFilter="Ignore" />
                                                            <Label Name="CredentialHeading" ClipText="True" />
                                                            <Label Name="CredentialName" ClipText="True" />
                                                            <Label Name="CredentialTitle" ClipText="True" />
                                                            <BoxContainer SeparationOverride="8">
                                                                <TextureRect Name="CredentialIcon" MinSize="20 20" MaxSize="20 20" Stretch="KeepAspectCentered" />
                                                                <Label Name="CredentialIff" ClipText="True" VerticalAlignment="Center" />
                                                            </BoxContainer>
                                                            <Control MinHeight="24" />
                                                        </BoxContainer>
                                                    </PanelContainer>
                                                    <Label Name="DossierHint" />
                                                </BoxContainer>
                                                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8">
                                                    <Label Name="DiffHeading" />
                                                    <Label Name="DiffSummary" />
                                                    <BoxContainer Name="DiffList" Orientation="Vertical" SeparationOverride="5" />
                                                    <Label Name="DiffHint" />
                                                </BoxContainer>
                                            </BoxContainer>
                                        </ScrollContainer>
                                    </PanelContainer>
                                    <PanelContainer Name="HistoryFrame" Visible="False" VerticalExpand="True">
                                        <ScrollContainer Name="HistoryPanel" HScrollEnabled="False" Margin="10">
                                            <BoxContainer Name="HistoryList" Orientation="Vertical" SeparationOverride="8" />
                                        </ScrollContainer>
                                    </PanelContainer>
                                    <PanelContainer Name="ReviewPanel">
                                        <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                                            <Label Name="Review" />
                                            <CheckBox Name="Confirm" />
                                            <BoxContainer SeparationOverride="8">
                                                <Button Name="CancelButton" HorizontalExpand="True" />
                                                <Button Name="ApplyButton" HorizontalExpand="True" />
                                            </BoxContainer>
                                        </BoxContainer>
                                    </PanelContainer>
                                </BoxContainer>
                                <PanelContainer Name="ManifestFrame" Visible="False" VerticalExpand="True">
                                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
                                        <BoxContainer SeparationOverride="8">
                                            <Label Name="ManifestHeading" HorizontalExpand="True" ClipText="True" />
                                            <Button Name="ManifestRefresh" />
                                        </BoxContainer>
                                        <Label Name="ManifestTimestamp" />
                                        <Label Name="ManifestHint" />
                                        <BoxContainer SeparationOverride="12" VerticalExpand="True">
                                            <PanelContainer Name="DepartmentSidebar" MinWidth="185" MaxWidth="185">
                                                <ScrollContainer HScrollEnabled="False" VerticalExpand="True" Margin="8">
                                                    <BoxContainer Name="DepartmentButtons" Orientation="Vertical" SeparationOverride="6" />
                                                </ScrollContainer>
                                            </PanelContainer>
                                            <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                                                <BoxContainer Name="ManifestHost" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6" />
                                            </ScrollContainer>
                                        </BoxContainer>
                                    </BoxContainer>
                                </PanelContainer>
                                <PanelContainer Name="CommunicationsFrame" Visible="False" VerticalExpand="True">
                                    <BoxContainer Orientation="Vertical" Margin="16" SeparationOverride="12">
                                        <Label Name="CommunicationsHeading" />
                                        <Label Name="CommunicationsHint" />
                                        <Label Name="BroadcastCaption" />
                                        <LineEdit Name="BroadcastText" HorizontalExpand="True" />
                                        <Label Name="BroadcastCount" />
                                        <CheckBox Name="ConfirmBroadcast" />
                                        <Button Name="SendBroadcast" />
                                        <Control MinHeight="14" />
                                        <Label Name="SirenStatus" />
                                        <CheckBox Name="ConfirmSiren" />
                                        <Button Name="ToggleSiren" />
                                        <Label Name="CommunicationsAccessHint" />
                                    </BoxContainer>
                                </PanelContainer>
                                <PanelContainer Name="PayrollFrame" Visible="False" VerticalExpand="True">
                                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                                        <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="10">
                                            <Label Name="PayrollHeading" />
                                            <Label Name="PayrollHint" />
                                            <BoxContainer SeparationOverride="8">
                                                <OptionButton Name="PayrollDepartment" HorizontalExpand="True" />
                                                <Button Name="PayrollRefresh" />
                                            </BoxContainer>
                                            <Label Name="PayrollBudget" />
                                            <OptionButton Name="PayrollEmployee" HorizontalExpand="True" />
                                            <Label Name="DefaultSalaryCaption" />
                                            <BoxContainer SeparationOverride="8">
                                                <LineEdit Name="DefaultSalaryText" HorizontalExpand="True" />
                                                <Button Name="SetDefaultSalary" />
                                            </BoxContainer>
                                            <Label Name="IndividualSalaryCaption" />
                                            <BoxContainer SeparationOverride="8">
                                                <LineEdit Name="IndividualSalaryText" HorizontalExpand="True" />
                                                <Button Name="SetIndividualSalary" />
                                                <Button Name="ClearSalaryOverride" />
                                            </BoxContainer>
                                            <Label Name="DepartmentFundingCaption" />
                                            <BoxContainer SeparationOverride="8">
                                                <LineEdit Name="DepartmentFundingText" HorizontalExpand="True" />
                                                <Button Name="FundDepartment" />
                                            </BoxContainer>
                                            <Button Name="TransferEmployee" />
                                            <CheckBox Name="ConfirmPayroll" />
                                            <Button Name="PayEmployee" />
                                            <Button Name="PayDepartment" />
                                            <Button Name="PayColony" />
                                        </BoxContainer>
                                    </ScrollContainer>
                                </PanelContainer>
                                <PanelContainer Name="OfficeServicesFrame" Visible="False" VerticalExpand="True">
                                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                                        <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="10">
                                            <Label Name="OfficeServicesHeading" />
                                            <Label Name="OfficeServicesHint" />
                                            <LineEdit Name="OfficeReportText" />
                                            <Button Name="OfficeReportSend" />
                                        </BoxContainer>
                                    </ScrollContainer>
                                </PanelContainer>
                                <PanelContainer Name="OfficeRequestsFrame" Visible="False" VerticalExpand="True">
                                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                                        <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="10">
                                            <Label Name="OfficeRequestsHeading" />
                                            <Button Name="OfficeRefresh" />
                                            <OptionButton Name="OfficeRequestChoices" />
                                            <Label Name="OfficeRequestDetails" />
                                            <Button Name="OfficePaper" />
                                            <CheckBox Name="OfficeDecisionConfirm" />
                                            <Button Name="OfficeApprove" />
                                            <Button Name="OfficeReject" />
                                            <Button Name="OfficeReprint" />
                                        </BoxContainer>
                                    </ScrollContainer>
                                </PanelContainer>
                                <PanelContainer Name="OfficeJailFrame" Visible="False" VerticalExpand="True">
                                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                                        <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="10">
                                            <Label Name="OfficeJailHeading" />
                                            <Label Name="OfficeJailHint" />
                                            <LineEdit Name="OfficeJailMinutes" />
                                            <LineEdit Name="OfficeJailReason" />
                                            <CheckBox Name="OfficeJailConfirm" />
                                            <Button Name="OfficeBook" />
                                            <OptionButton Name="OfficeJailChoices" />
                                            <Button Name="OfficeRelease" />
                                            <BoxContainer Name="OfficeJailList" Orientation="Vertical" SeparationOverride="7" />
                                        </BoxContainer>
                                    </ScrollContainer>
                                </PanelContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <Control Name="CrtLayer" MouseFilter="Ignore" />
                        <PanelContainer Name="BootOverlay" Visible="False" MouseFilter="Stop">
                            <BoxContainer Orientation="Vertical" VerticalAlignment="Center" Margin="34" SeparationOverride="14">
                                <Control Name="BootLogo" MinSize="128 128" MaxSize="128 128" MouseFilter="Ignore" />
                                <Label Name="BootBrand" ClipText="True" />
                                <Label Name="BootStatus" />
                                <Control Name="BootProgress" MinHeight="12" MouseFilter="Ignore" />
                                <Button Name="SkipBootButton" />
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer Name="ResultPanel" Visible="False" MinWidth="340" HorizontalAlignment="Center" VerticalAlignment="Center" MouseFilter="Ignore">
                            <Control Name="ResultArt" MouseFilter="Ignore" />
                            <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="22 18" MouseFilter="Ignore">
                                <Label Name="ResultTitle" HorizontalAlignment="Center" MouseFilter="Ignore" />
                                <Label Name="ResultDetail" HorizontalAlignment="Center" MouseFilter="Ignore" />
                            </BoxContainer>
                        </PanelContainer>
                    </PanelContainer>
                </PanelContainer>
                <PanelContainer Name="NavigationPanel" MinWidth="208" MaxWidth="208">
                    <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="12">
                        <Label Name="OperationsCaption" />
                        <Button Name="HireButton" />
                        <Button Name="EditButton" />
                        <Button Name="TerminateButton" />
                        <Button Name="HistoryButton" />
                        <Button Name="PreviewButton" />
                        <Label Name="ReaderCaption" Margin="0 6 0 0" />
                        <Control Name="OperatorArt" MinSize="180 44" MaxHeight="44" MouseFilter="Ignore" />
                        <Button Name="OperatorSlot" />
                        <Label Name="OperatorIdentity" ClipText="True" />
                        <Control Name="TargetArt" MinSize="180 44" MaxHeight="44" MouseFilter="Ignore" />
                        <Button Name="TargetSlot" />
                        <Label Name="EmployeeIdentity" ClipText="True" />
                        <Label Name="ReaderHint" Visible="False" />
                        <Control Name="PrinterArt" MinSize="180 44" MaxHeight="44" MouseFilter="Ignore" />
                        <Label Name="PrinterCaption" />
                        <Label Name="TerminalFooter" Visible="False" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
            <BoxContainer SeparationOverride="14">
                <Label Name="CabinetCaption" HorizontalExpand="True" />
                <Label Name="PowerCaption" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
