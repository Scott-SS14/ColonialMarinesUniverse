<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               MinSize="860 620" SetSize="980 720">
    <PanelContainer Name="Bezel">
        <PanelContainer Name="Screen" Margin="5">
            <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="14">
                <PanelContainer Name="HeaderPanel">
                    <BoxContainer Orientation="Vertical" Margin="10 7" SeparationOverride="3">
                        <Label Name="Brand" />
                        <Label Name="Heading" />
                    </BoxContainer>
                </PanelContainer>
                <BoxContainer SeparationOverride="8">
                    <Label Name="Status" HorizontalExpand="True" ClipText="True" />
                    <Button Name="RefreshButton" />
                </BoxContainer>
                <BoxContainer SeparationOverride="12" VerticalExpand="True">
                    <PanelContainer Name="NavigationPanel" MinWidth="190" MaxWidth="190">
                        <BoxContainer Orientation="Vertical" SeparationOverride="7" Margin="10">
                            <Label Name="OperationsCaption" />
                            <Button Name="HireButton" />
                            <Button Name="EditButton" />
                            <Button Name="TerminateButton" />
                            <Button Name="HistoryButton" />
                            <Label Name="ReaderCaption" Margin="0 12 0 0" />
                            <Button Name="OperatorSlot" />
                            <Button Name="TargetSlot" />
                            <Label Name="ReaderHint" />
                            <Control VerticalExpand="True" />
                            <Label Name="TerminalFooter" />
                        </BoxContainer>
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="9">
                        <Label Name="CurrentTitle" ClipText="True" />
                        <BoxContainer Name="Workspace" Orientation="Vertical" VerticalExpand="True" SeparationOverride="10">
                            <PanelContainer Name="IdentityPanel">
                                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="5">
                                    <BoxContainer SeparationOverride="12">
                                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                            <Label Name="NameCaption" />
                                            <LineEdit Name="NameField" />
                                        </BoxContainer>
                                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                            <Label Name="TitleCaption" />
                                            <LineEdit Name="TitleField" />
                                        </BoxContainer>
                                    </BoxContainer>
                                    <CheckBox Name="Iff" />
                                    <Label Name="IffHint" />
                                    <BoxContainer Name="IconRow" SeparationOverride="8">
                                        <Label Name="IconCaption" VerticalAlignment="Center" />
                                        <TextureRect Name="IconPreview" MinSize="24 24" MaxSize="24 24" />
                                        <OptionButton Name="IconChoices" HorizontalExpand="True" />
                                    </BoxContainer>
                                </BoxContainer>
                            </PanelContainer>
                            <BoxContainer SeparationOverride="10" VerticalExpand="True">
                                <PanelContainer Name="PresetPanel" MinWidth="210" MaxWidth="210">
                                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="7">
                                        <Label Name="PresetCaption" />
                                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                                            <BoxContainer Name="Presets" Orientation="Vertical" SeparationOverride="5" />
                                        </ScrollContainer>
                                    </BoxContainer>
                                </PanelContainer>
                                <PanelContainer Name="AccessPanel" HorizontalExpand="True">
                                    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                                        <Label Name="AccessCaption" />
                                        <LineEdit Name="AccessSearch" />
                                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                                            <BoxContainer Name="AccessList" Orientation="Vertical" SeparationOverride="4" />
                                        </ScrollContainer>
                                        <BoxContainer SeparationOverride="6">
                                            <Label Name="AccessCount" HorizontalExpand="True" />
                                            <Button Name="ClearAccessButton" />
                                        </BoxContainer>
                                    </BoxContainer>
                                </PanelContainer>
                            </BoxContainer>
                        </BoxContainer>
                        <PanelContainer Name="HistoryFrame" Visible="False" VerticalExpand="True">
                            <ScrollContainer Name="HistoryPanel" HScrollEnabled="False" Margin="10">
                                <BoxContainer Name="HistoryList" Orientation="Vertical" SeparationOverride="8" />
                            </ScrollContainer>
                        </PanelContainer>
                        <PanelContainer Name="ReviewPanel">
                            <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                                <Label Name="Review" />
                                <CheckBox Name="Confirm" />
                                <BoxContainer SeparationOverride="8">
                                    <Button Name="CancelButton" HorizontalExpand="True" />
                                    <Button Name="ApplyButton" HorizontalExpand="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </PanelContainer>
</DefaultWindow>
